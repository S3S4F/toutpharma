# Copier en `.env` à côté du docker-compose*.yml, puis remplir.

# --- Sécurité admin (OBLIGATOIRE) ---
ADMIN_PASSWORD=changez-moi
ADMIN_TOKEN_SECRET=une-longue-chaine-aleatoire

# Origines autorisées si l'API est exposée séparément (séparées par des virgules).
# Laisser vide lorsque le front nginx et l'API partagent le même domaine.
CORS_ORIGINS=

# --- URL publique du site (liens PDF envoyés dans les messages WhatsApp) ---
# En local : http://localhost:8080 — en prod : https://votre-domaine.sn
PUBLIC_URL=http://localhost:8080

# --- Port exposé par le front (nginx) ---
FRONT_PORT=8080

# --- 2FA admin (optionnel mais recommandé) ---
# Générer : cd toutpharma-backend && npm run totp-setup
# puis scanner le QR dans Google Authenticator. Vide = 2FA désactivée.
ADMIN_TOTP_SECRET=

# --- Notification WhatsApp de commande (optionnel, API OFFICIELLE Meta) ---
# Console Meta for Developers → app WhatsApp Business. Vide = désactivé
# (le flux wa.me côté client continue de fonctionner sans rien).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=

# --- Production uniquement (docker-compose.prod.yml) ---
# Préfixe des images publiées par la CI sur GitHub Container Registry :
# ghcr.io/<votre-user-github>/<nom-du-repo>
IMAGE_PREFIX=ghcr.io/mon-user/mon-repo
TAG=latest

# --- Alternative SANS Meta : passerelle OpenWA auto-hébergée ---
# (github.com/rmyndharis/OpenWA — ⚠️ numéro ÉMETTEUR secondaire dédié,
# risque de ban inhérent aux clients non officiels). Prioritaire sur Meta.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY=
WHATSAPP_GATEWAY_SESSION=
