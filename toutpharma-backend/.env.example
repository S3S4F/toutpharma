# Port d'écoute (défaut 3001).
PORT=3001
# URL publique de l'API, utilisée pour les liens vers les images uploadées.
# En prod, mettre le domaine réel (ex: https://api.toutpharma.sn).
PUBLIC_URL=http://localhost:3001

# 2FA admin (optionnel) : npm run totp-setup, puis scanner dans Google Authenticator
ADMIN_TOTP_SECRET=

# Notification WhatsApp de commande (optionnel, API officielle Meta Cloud)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
# Alternative sans Meta : passerelle OpenWA auto-hébergée (prioritaire)
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY=
WHATSAPP_GATEWAY_SESSION=
