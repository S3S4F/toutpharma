# Copier en `.env` à côté du docker-compose*.yml, puis remplir.

# --- Sécurité admin (OBLIGATOIRE) ---
ADMIN_PASSWORD=changez-moi
ADMIN_TOKEN_SECRET=une-longue-chaine-aleatoire

# --- URL publique du site (liens  PDF/images envoyés sur WhatsApp) ---
# En local : http://localhost:8080 — en prod : https://votre-domaine.sn
PUBLIC_URL=http://localhost:8080

# --- Port exposé par le front (nginx) ---
# En local : n'importe quel port libre (8080 par défaut).
# En prod sur le VPS : ports alloués à partir de 8101 (plusieurs projets
# partagent le serveur), donc PORT PUBLIC = 8101 pour ToutPharma.
FRONT_PORT=8101

# --- Production uniquement (docker-compose.prod.yml) ---
# Préfixe des images publiées par la CI sur Docker Hub :
# <votre-user-dockerhub>/toutpharma  (donne <user>/toutpharma-backend et -front)
IMAGE_PREFIX=mon-user-dockerhub/toutpharma
TAG=latest
